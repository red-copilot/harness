{
  "name": "red-harness-observability",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "api:generate": "openapi-typescript ../api/openapi.yaml -o src/api/generated.ts",
    "api:check": "openapi-typescript ../api/openapi.yaml -o src/api/generated.ts && git diff --exit-code -- src/api/generated.ts"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-virtual": "3.14.21",
    "antd": "6.6.7",
    "dayjs": "1.11.23",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
